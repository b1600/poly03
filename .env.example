# Copy to .env and fill in. Never commit the real .env.
# Nothing here is required for read-only Gamma/CLOB market data --
# only needed once you wire in authenticated calls or live order placement.

# L1: wallet that signs orders / derives API creds (Polygon private key, 0x-prefixed)
POLYMARKET_PRIVATE_KEY=
# Optional: proxy/funder wallet address if trading through a Polymarket proxy wallet
POLYMARKET_FUNDER_ADDRESS=

# L2: CLOB API credentials (derived from the L1 key via py-clob-client's
# create_or_derive_api_creds(), not something you invent yourself)
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=

POLYMARKET_CHAIN_ID=137

GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Optional: mirror `poly03 paper run` console output to a Telegram chat.
# Create a bot via @BotFather for the token; TELEGRAM_CHAT_ID is the chat to
# post into (message the bot once, then GET
# https://api.telegram.org/bot<token>/getUpdates to find your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
